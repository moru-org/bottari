generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  provider       String    // "kakao" | "google" | "mock"
  providerUserId String    @unique
  name           String?
  avatar         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  packs          Pack[]

  @@index([provider, providerUserId])
}

model PackTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique
  type        String   // "friend_quiz" | "guess_me" | "first_impression" | "anonymous_feedback" | "balance"
  category    String   // "friend" | "love" | "balance" | "anonymous" | "fun"
  title       String
  description String?
  emoji       String   @default("🎁")
  isFeatured  Boolean  @default(false)
  order       Int      @default(0)
  payload     String   // JSON: PackDefinition (Snapshot source)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packs       Pack[]    @relation("TemplateToPack")

  @@index([slug])
  @@index([type])
  @@index([category])
  @@index([isFeatured])
}

model Pack {
  id             String            @id @default(cuid())
  slug           String            @unique
  templateId     String?
  template       PackTemplate?     @relation("TemplateToPack", fields: [templateId], references: [id])
  
  type           String            @default("friend_quiz") // "friend_quiz" | "guess_me" | "first_impression" | "anonymous_feedback" | "balance"
  title          String
  description    String?
  status         String            @default("active") // "active" | "disabled"
  ownerId        String?
  ownerTokenHash String?           // SHA-256(owner_token)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  owner          User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  
  questions      PackQuestion[]
  characters     PackResultCharacter[]
  submissions    Submission[]
  events         Event[]         @relation("PackToEvents")

  @@index([slug])
  @@index([type])
  @@index([status])
  @@index([ownerId])
  @@index([ownerTokenHash])
}

model PackResultCharacter {
  id          String   @id @default(cuid())
  packId      String
  pack        Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  emoji       String
  name        String
  description String?
  order       Int      @default(0)
  
  scores      ScoreMapping[]

  @@index([packId, order])
}

model PackQuestion {
  id        String   @id @default(cuid())
  packId    String
  pack      Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  content   String
  order     Int      @default(0)
  type      String   @default("single_choice") // single_choice, multi_choice, rating, slider, ranking, short_text, prediction
  
  options   QuestionOption[]
  answers   SubmissionAnswer[] @relation("QuestionToAnswers")

  @@index([packId, order])
}

model QuestionOption {
  id        String   @id @default(cuid())
  questionId String
  question  PackQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content   String
  order     Int      @default(0)
  
  scores    ScoreMapping[]
  answers   SubmissionAnswer[] @relation("OptionToAnswers")

  @@index([questionId, order])
}

model ScoreMapping {
  id         String   @id @default(cuid())
  optionId   String
  option     QuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  characterId String
  character  PackResultCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  score      Int      @default(1)

  @@unique([optionId, characterId])
}

model Submission {
  id             String    @id @default(cuid())
  packId         String
  pack           Pack      @relation(fields: [packId], references: [id], onDelete: Cascade)
  sessionToken   String?   // 익명 플레이어 세션 식별자
  createdAt      DateTime  @default(now())

  answers        SubmissionAnswer[]

  @@index([packId])
  @@index([packId, sessionToken])
}

model SubmissionAnswer {
  id           String   @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     PackQuestion @relation("QuestionToAnswers", fields: [questionId], references: [id], onDelete: Cascade)
  optionId     String?
  option       QuestionOption? @relation("OptionToAnswers", fields: [optionId], references: [id], onDelete: Cascade)
  value        String? // For rating, slider, short_text, etc.

  @@unique([submissionId, questionId])
}

model Event {
  id         String   @id @default(cuid())
  packId     String
  pack       Pack     @relation("PackToEvents", fields: [packId], references: [id], onDelete: Cascade)
  eventType  String   // "content_viewed" | "bottari_opened" | "play_started" | "question_answered" | "play_completed" | "result_viewed" | "share_clicked" | "link_copied" | "create_from_result_clicked" | "reaction_created"
  metadata   String?  // JSON
  createdAt  DateTime @default(now())

  @@index([packId, eventType])
}
